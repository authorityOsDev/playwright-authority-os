# -------------------------------------------------------
# Authority OS — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# -------------------------------------------------------

# Target environment (staging | prod | dev)
ENV=staging

# Base URL of the application under test
BASE_URL=https://www.saucedemo.com

# Test account credentials
STANDARD_USER=standard_user
PASSWORD=secret_sauce

# Checkout form data (used by checkout tests)
CHECKOUT_FIRST_NAME=Jane
CHECKOUT_LAST_NAME=Doe
CHECKOUT_ZIP=10001

# API authentication token — only needed if your app requires bearer auth
# Leave blank if your app has no API auth requirement
API_TOKEN=

# Notion integration — get token from notion.so/my-integrations
NOTION_TOKEN=your_notion_token_here
# CI Run History database ID (auto-updated after every test run)
NOTION_DATABASE_ID=your_notion_database_id_here
# Test Inventory database ID (seeded once via: npx ts-node utils/notion-seed.ts)
NOTION_TEST_INVENTORY_DB=your_test_inventory_database_id_here

# Allure report public URL — set to your Surge.sh domain after first deploy
# Also set this as a GitHub Variable (vars.ALLURE_REPORT_URL) for CI
ALLURE_REPORT_URL=https://your-project.surge.sh
