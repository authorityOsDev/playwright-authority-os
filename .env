BASE_URL=https://www.saucedemo.com
STANDARD_USER=standard_user
PASSWORD=secret_sauce

# Checkout test data (used as fallback values in checkout tests)
CHECKOUT_FIRST_NAME=John
CHECKOUT_LAST_NAME=Doe
CHECKOUT_ZIP=12345

# Notion integration — get these from notion.so/my-integrations
NOTION_TOKEN=your_notion_token_here
# CI Run History database (auto-updated after every test run)
NOTION_DATABASE_ID=your_notion_database_id_here
# Test Inventory database (seeded once via: npx ts-node utils/notion-seed.ts)
NOTION_TEST_INVENTORY_DB=your_test_inventory_database_id_here

# Allure report public URL — set to your Surge.sh domain after first deploy
ALLURE_REPORT_URL=https://your-project.surge.sh

# API auth token — only needed if your app requires bearer auth for API teardown
# Leave blank or remove if your app has no REST API auth
API_TOKEN=
