{
  "name": "playwright-authority-os",
  "version": "1.0.0",
  "description": "Authority OS — AI-Native Playwright Framework with strict POM, cross-browser CI, and Allure reporting",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ci": "playwright test --project=chromium",
    "report:generate": "allure generate ./allure-results -o allure-report",
    "report:open": "allure open",
    "lint": "eslint .",
    "report:notion": "npx ts-node utils/notion-update.ts",
    "test:json": "mkdir -p test-results && playwright test",
    "ship-it": "npm run test:json && npm run report:notion",
    "test:visual": "playwright test --grep @visual --update-snapshots"
  },
  "keywords": [
    "playwright",
    "typescript",
    "e2e",
    "pom",
    "testing",
    "automation",
    "ai"
  ],
  "author": "AuthorityOS Dev",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "allure-playwright": "^3.7.1",
    "eslint": "^10.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.1"
  },
  "dependencies": {
    "@notionhq/client": "^5.19.0",
    "dotenv": "^17.4.2"
  }
}
